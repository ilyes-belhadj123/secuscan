# Copier ce fichier en .env et renseigner les valeurs (ne jamais committer .env)

# Clé OpenRouter pour l'enrichissement IA (Claude). Sans clé : mode cache uniquement.
OPENROUTER_API_KEY=
# Modèle utilisé via OpenRouter
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Dossier de données locales (base SQLite, cache IA, uploads temporaires)
SECUSCAN_DATA_DIR=./data
# Couper l'IA même si une clé est renseignée (tests sans coût) : true/false
SECUSCAN_AI_DISABLED=false
# Nombre d'appels IA en parallèle
SECUSCAN_AI_CONCURRENCY=6
# Désactiver les appels réseau vers la base d'advisories (OSV) : true/false
SECUSCAN_OFFLINE=false

# Offre de la toute première organisation créée (les suivantes démarrent en free)
SECUSCAN_FIRST_ORG_PLAN=business
# Tarifs indicatifs en € HT par membre et par mois (provisoires)
SECUSCAN_PRICE_PRO_EUR=29
SECUSCAN_PRICE_BUSINESS_EUR=79
# Secret partagé avec le prestataire de paiement pour signer les webhooks (vide : désactivé)
SECUSCAN_BILLING_WEBHOOK_SECRET=
# Offre utilisée par les outils internes (benchmark, préparation de la démo)
SECUSCAN_PLAN=pro
# Tarifs du modèle en $ par million de jetons (estimation des coûts)
SECUSCAN_AI_PRICE_INPUT_PER_MTOK=2.0
SECUSCAN_AI_PRICE_OUTPUT_PER_MTOK=10.0
